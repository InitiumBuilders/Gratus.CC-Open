# GRATUS.CC · the environment, by name only.
#
# Every value here is a secret or a machine-local path, so this file carries none of
# them. The publish gate reads it and refuses to let it leave with a value attached.
# Copy it to .env.local and fill it in there, which is never committed and never
# published.

# the Vercel Blob store. Without it the trace, the rooms, the stream and the voice allowance all answer 503 rather than pretending to work.
BLOB_READ_WRITE_TOKEN=

# speech to text. Leave it unset and the voice button is simply not offered.
ELEVENLABS_API_KEY=

# a browser for the gates that open one. Unset, they look through the Playwright cache and then the usual system paths.
GRATUS_CHROMIUM=

# where the list of names that must never be published is kept, one name a line. Unset, the gate looks in .config/gratus/private-names under the home folder. The list is kept outside the tree, because everything in the tree is deployed.
GRATUS_PRIVATE_NAMES=

# the salt for every counter that hashes a caller. These documents are world readable, so a salt anyone can read turns them back into the addresses that wrote them. Any long random string; changing it resets the day’s counters and nothing else.
GRATUS_SALT=

# the number of loose strings G21 is allowed to find before it goes red.
GRATUS_STRINGS_BASELINE=

# where that cache lives, if it is not the default.
PLAYWRIGHT_BROWSERS_PATH=

# the Stripe secret key. Without it no card is ever charged and the app says so plainly instead of pretending.
STRIPE_SECRET_KEY=

# the recurring price to subscribe somebody to: twenty-four dollars a month.
STRIPE_PRICE_ID=

# the secret the webhook signature is checked against. An event that does not verify is refused and nothing is written.
STRIPE_WEBHOOK_SECRET=
